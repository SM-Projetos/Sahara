import { ScrollView } from "std-widgets.slint";

import "../assets/fonts/Inter-Regular.ttf";
import "../assets/fonts/Inter-Medium.ttf";
import "../assets/fonts/Inter-SemiBold.ttf";
import "../assets/fonts/Inter-Bold.ttf";
import "../assets/fonts/Inter-ExtraBold.ttf";

export struct FileEntry {
    name: string,
    path: string,
    is_directory: bool,
}

export global Theme {
    out property <color> window-bg: #061a32;
    out property <brush> sidebar-bg: @linear-gradient(180deg, #061a32 0%, #041329 100%);
    out property <color> topbar-bg: #061a32;
    out property <brush> page-bg: @linear-gradient(18deg, #092d50 0%, #071d37 52%, #04162b 100%);
    out property <brush> card-bg: @linear-gradient(145deg, #0c2b49 0%, #08223e 58%, #071d36 100%);
    out property <color> nav-hover: #102e49;
    out property <color> card-border: #1a3e5e;
    out property <color> separator: #193552;
    out property <color> text-main: #f4f8ff;
    out property <color> text-muted: #a8c6da;
    out property <color> accent: #16d3e8;
    out property <color> accent-deep: #087fc7;
    out property <color> active-menu: #0796d4;
    out property <color> row-hover: #103554;
    out property <color> address-bg: #07192e;
}

component SidebarItem inherits Rectangle {
    in property <string> label;
    in property <image> icon-image;
    in property <bool> active: false;
    callback selected();

    height: 40px;
    border-radius: 12px;
    background: root.active ? Theme.active-menu : (touch.has-hover ? Theme.nav-hover : #00000000);
    animate background { duration: 300ms; }

    HorizontalLayout {
        padding-left: 13px;
        padding-right: 10px;
        spacing: 12px;
        alignment: center;

        Image {
            source: root.icon-image;
            width: 20px;
            height: 20px;
            image-fit: contain;
            colorize: root.active ? #ffffff : Theme.text-muted;
            animate colorize { duration: 300ms; }
        }

        Text {
            font-family: "Inter";
            text: root.label;
            color: root.active ? #ffffff : Theme.text-main;
            animate color { duration: 300ms; }
            font-size: 13px;
            font-weight: root.active ? 700 : 550;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
    }

    touch := TouchArea {
        clicked => { root.selected(); }
    }
}

component Sidebar inherits Rectangle {
    in property <string> active-location: "home";
    callback location-selected(string);

    width: 248px;
    background: Theme.sidebar-bg;

    VerticalLayout {
        padding-left: 16px;
        padding-right: 16px;
        padding-top: 18px;
        padding-bottom: 14px;
        spacing: 12px;

        VerticalLayout {
            alignment: center;
            spacing: 7px;

            Image {
                source: @image-url("../assets/icons/sahara.svg");
                width: 54px;
                height: 54px;
                image-fit: contain;
            }

            Text {
                font-family: "Inter";
                text: "Sahara";
                color: Theme.text-main;
                font-size: 22px;
                font-weight: 800;
                horizontal-alignment: center;
            }

            Text {
                font-family: "Inter";
                text: "Gerenciador de arquivos";
                color: Theme.text-muted;
                font-size: 10px;
                font-weight: 500;
                horizontal-alignment: center;
            }
        }

        Rectangle {
            height: 1px;
            background: Theme.separator;
        }

        VerticalLayout {
            spacing: 5px;

            Text {
                font-family: "Inter";
                text: "LOCAIS";
                color: Theme.text-muted;
                font-size: 10px;
                font-weight: 750;
            }

            SidebarItem {
                label: "Início";
                icon-image: @image-url("../assets/icons/home.svg");
                active: root.active-location == "home";
                selected => { root.location-selected("home"); }
            }
            SidebarItem {
                label: "Área de Trabalho";
                icon-image: @image-url("../assets/icons/desktop.svg");
                active: root.active-location == "desktop";
                selected => { root.location-selected("desktop"); }
            }
            SidebarItem {
                label: "Documentos";
                icon-image: @image-url("../assets/icons/documents.svg");
                active: root.active-location == "documents";
                selected => { root.location-selected("documents"); }
            }
            SidebarItem {
                label: "Downloads";
                icon-image: @image-url("../assets/icons/downloads.svg");
                active: root.active-location == "downloads";
                selected => { root.location-selected("downloads"); }
            }
            SidebarItem {
                label: "Imagens";
                icon-image: @image-url("../assets/icons/images.svg");
                active: root.active-location == "pictures";
                selected => { root.location-selected("pictures"); }
            }
            SidebarItem {
                label: "Músicas";
                icon-image: @image-url("../assets/icons/music.svg");
                active: root.active-location == "music";
                selected => { root.location-selected("music"); }
            }
            SidebarItem {
                label: "Vídeos";
                icon-image: @image-url("../assets/icons/video.svg");
                active: root.active-location == "videos";
                selected => { root.location-selected("videos"); }
            }
        }

        Rectangle {
            height: 1px;
            background: Theme.separator;
        }

        VerticalLayout {
            spacing: 5px;

            Text {
                font-family: "Inter";
                text: "DISPOSITIVOS";
                color: Theme.text-muted;
                font-size: 10px;
                font-weight: 750;
            }

            SidebarItem {
                label: "Sistema de arquivos";
                icon-image: @image-url("../assets/icons/hard-drive.svg");
                active: root.active-location == "filesystem";
                selected => { root.location-selected("filesystem"); }
            }
        }

        Rectangle {
            vertical-stretch: 1;
            background: #00000000;
        }

        Rectangle {
            height: 58px;
            border-radius: 15px;
            border-width: 1px;
            border-color: Theme.separator;
            background: #071a31;

            VerticalLayout {
                padding-left: 13px;
                padding-right: 10px;
                alignment: center;
                spacing: 3px;

                Text {
                    font-family: "Inter";
                    text: "Sahara";
                    color: Theme.text-main;
                    font-size: 13px;
                    font-weight: 700;
                }

                Text {
                    font-family: "Inter";
                    text: "v0.1.0";
                    color: Theme.text-muted;
                    font-size: 11px;
                }
            }
        }
    }

    Rectangle {
        x: parent.width - 1px;
        width: 1px;
        height: parent.height;
        background: Theme.separator;
    }
}

component AddressToolbar inherits Rectangle {
    in property <string> current-path;
    callback go-back();

    height: 68px;
    background: Theme.topbar-bg;

    HorizontalLayout {
        padding-left: 25px;
        padding-right: 26px;
        spacing: 12px;
        alignment: center;

        Rectangle {
            width: 40px;
            height: 40px;
            border-radius: 12px;
            background: back-touch.has-hover ? Theme.nav-hover : Theme.address-bg;

            Image {
                source: @image-url("../assets/icons/arrow-left.svg");
                width: 19px;
                height: 19px;
                image-fit: contain;
                colorize: Theme.text-main;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
            }

            back-touch := TouchArea {
                clicked => { root.go-back(); }
            }
        }

        Rectangle {
            horizontal-stretch: 1;
            height: 42px;
            border-radius: 13px;
            border-width: 1px;
            border-color: Theme.separator;
            background: Theme.address-bg;

            HorizontalLayout {
                padding-left: 13px;
                padding-right: 13px;
                spacing: 10px;
                alignment: center;

                Image {
                    source: @image-url("../assets/icons/folder.svg");
                    width: 17px;
                    height: 17px;
                    image-fit: contain;
                    colorize: Theme.accent;
                }

                Text {
                    font-family: "Inter";
                    text: root.current-path;
                    color: Theme.text-muted;
                    font-size: 12px;
                    font-weight: 500;
                    overflow: elide;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
            }
        }
    }

    Rectangle {
        y: parent.height - 1px;
        width: parent.width;
        height: 1px;
        background: Theme.separator;
    }
}

component DirectoryRow inherits Rectangle {
    in property <string> item-name;
    in property <string> item-path;
    in property <bool> is-directory;
    callback activated(string);

    height: 48px;
    border-radius: 10px;
    background: touch.has-hover ? Theme.row-hover : #00000000;
    animate background { duration: 300ms; }

    HorizontalLayout {
        width: 100%;
        padding-left: 12px;
        padding-right: 12px;
        spacing: 12px;
        alignment: center;

        Image {
            source: root.is-directory
                ? @image-url("../assets/icons/folder.svg")
                : @image-url("../assets/icons/file.svg");
            width: 21px;
            height: 21px;
            image-fit: contain;
            colorize: root.is-directory ? Theme.accent : Theme.text-muted;
        }

        Text {
            font-family: "Inter";
            text: root.item-name;
            color: Theme.text-main;
            font-size: 13px;
            font-weight: root.is-directory ? 600 : 450;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }

        Rectangle {
            width: 74px;
            height: 25px;
            border-radius: 13px;
            background: root.is-directory ? #103d59 : #102b43;

            Text {
                font-family: "Inter";
                text: root.is-directory ? "Pasta" : "Arquivo";
                color: root.is-directory ? #8fe7f1 : Theme.text-muted;
                font-size: 10px;
                font-weight: 650;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }

    touch := TouchArea {
        clicked => {
            if root.is-directory {
                root.activated(root.item-path);
            }
        }
    }
}

export component MainWindow inherits Window {
    title: "Sahara";
    preferred-width: 1180px;
    preferred-height: 760px;
    min-width: 820px;
    min-height: 560px;
    background: Theme.window-bg;

    in property <[FileEntry]> entries;
    in property <string> current_path;
    in property <string> status;
    in-out property <string> selected_location: "home";
    callback open_directory(string);
    callback open_location(string);
    callback go_back();

    HorizontalLayout {
        spacing: 0px;

        Sidebar {
            active-location: root.selected_location;
            location-selected(location) => {
                root.selected_location = location;
                root.open_location(location);
            }
        }

        Rectangle {
            horizontal-stretch: 1;
            background: Theme.page-bg;

            VerticalLayout {
                spacing: 0px;

                AddressToolbar {
                    current-path: root.current_path;
                    go-back => {
                        root.selected_location = "";
                        root.go_back();
                    }
                }

                VerticalLayout {
                    padding-left: 28px;
                    padding-right: 28px;
                    padding-top: 23px;
                    padding-bottom: 17px;
                    spacing: 16px;

                    VerticalLayout {
                        spacing: 5px;

                        Text {
                            font-family: "Inter";
                            text: "Arquivos";
                            color: Theme.text-main;
                            font-size: 28px;
                            font-weight: 800;
                        }

                        Text {
                            font-family: "Inter";
                            text: "Navegue pelos seus arquivos e pastas.";
                            color: Theme.text-muted;
                            font-size: 12px;
                            font-weight: 450;
                        }
                    }

                    Rectangle {
                        vertical-stretch: 1;
                        border-radius: 17px;
                        border-width: 1px;
                        border-color: Theme.card-border;
                        background: Theme.card-bg;
                        clip: true;

                        VerticalLayout {
                            padding: 9px;
                            spacing: 3px;

                            Rectangle {
                                height: 34px;
                                background: #071d35;
                                border-radius: 9px;

                                HorizontalLayout {
                                    width: 100%;
                                    padding-left: 12px;
                                    padding-right: 12px;
                                    spacing: 12px;
                                    alignment: center;

                                    // Reserva o mesmo espaço do ícone existente em cada linha.
                                    Rectangle {
                                        width: 21px;
                                        background: #00000000;
                                    }

                                    Text {
                                        font-family: "Inter";
                                        text: "NOME";
                                        color: Theme.text-muted;
                                        font-size: 10px;
                                        font-weight: 750;
                                        horizontal-stretch: 1;
                                    }

                                    Text {
                                        font-family: "Inter";
                                        text: "TIPO";
                                        color: Theme.text-muted;
                                        font-size: 10px;
                                        font-weight: 750;
                                        width: 74px;
                                        horizontal-alignment: center;
                                    }
                                }
                            }

                            Rectangle {
                                width: 100%;
                                height: 1px;
                                background: Theme.separator;
                            }

                            Rectangle {
                                vertical-stretch: 1;
                                background: #00000000;
                                clip: true;

                                ScrollView {
                                    width: 100%;
                                    height: 100%;
                                    content-height: root.entries.length == 0 ? 400px : root.entries.length * 51px + 10px;
                                    vertical-scrollbar-policy: as-needed;
                                    horizontal-scrollbar-policy: always-off;
                                    mouse-drag-pan-enabled: true;

                                    VerticalLayout {
                                        width: 100%;
                                        height: root.entries.length == 0 ? 400px : root.entries.length * 51px + 10px;
                                        padding-top: 3px;
                                        padding-bottom: 3px;
                                        spacing: 3px;

                                        if root.entries.length == 0 : Rectangle {
                                            width: 100%;
                                            height: 390px;
                                            background: #00000000;
                                            VerticalLayout {
                                                alignment: center;
                                                spacing: 10px;
                                                Image {
                                                    source: @image-url("../assets/icons/folder.svg");
                                                    width: 38px;
                                                    height: 38px;
                                                    image-fit: contain;
                                                    colorize: Theme.text-muted;
                                                }
                                                Text {
                                                    font-family: "Inter";
                                                    text: root.status;
                                                    color: Theme.text-muted;
                                                    font-size: 12px;
                                                    horizontal-alignment: center;
                                                    vertical-alignment: center;
                                                }
                                            }
                                        }

                                        for entry in root.entries : DirectoryRow {
                                            width: 100%;
                                            item-name: entry.name;
                                            item-path: entry.path;
                                            is-directory: entry.is_directory;
                                            activated(path) => {
                                                root.selected_location = "";
                                                root.open_directory(path);
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                Rectangle {
                    height: 36px;
                    background: Theme.topbar-bg;

                    HorizontalLayout {
                        padding-left: 24px;
                        padding-right: 24px;
                        alignment: center;

                        Text {
                            font-family: "Inter";
                            text: root.status;
                            color: Theme.text-muted;
                            font-size: 10px;
                            font-weight: 500;
                        }
                    }
                }
            }
        }
    }
}
