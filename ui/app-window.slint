export struct FileEntry {
    name: string,
    path: string,
    is_directory: bool,
}

export component MainWindow inherits Window {
    title: "Sahara";
    width: 1180px;
    height: 760px;
    min-width: 820px;
    min-height: 560px;
    background: Theme.background;

    in property <[FileEntry]> entries;
    in property <string> current_path;
    in property <string> status;
    callback open_directory(string);
    callback open_location(string);
    callback go_back();

    HorizontalLayout {
        spacing: 0px;
        Rectangle {
            width: 224px;
            background: Theme.sidebar;
            VerticalLayout {
                padding: 18px;
                spacing: 18px;
                Text { text: "Sahara"; color: Theme.text; font-size: 22px; font-weight: 700; }
                Text { text: "Gerenciador de arquivos"; color: Theme.muted; font-size: 11px; }
                Rectangle { height: 1px; background: Theme.border; }
                Text { text: "LOCAIS"; color: Theme.muted; font-size: 10px; font-weight: 600; }
                Rectangle {
                    height: 24px;
                    TouchArea { clicked => { root.open_location("home"); } }
                    Text {
                        x: 0px; width: parent.width; height: parent.height;
                        text: "Início"; color: Theme.secondary; font-size: 13px;
                        horizontal-alignment: left; vertical-alignment: center;
                    }
                }
                Rectangle {
                    height: 24px;
                    TouchArea { clicked => { root.open_location("desktop"); } }
                    Text {
                        x: 0px; width: parent.width; height: parent.height;
                        text: "Área de Trabalho"; color: Theme.secondary; font-size: 13px;
                        horizontal-alignment: left; vertical-alignment: center;
                    }
                }
                Rectangle {
                    height: 24px;
                    TouchArea { clicked => { root.open_location("documents"); } }
                    Text {
                        x: 0px; width: parent.width; height: parent.height;
                        text: "Documentos"; color: Theme.secondary; font-size: 13px;
                        horizontal-alignment: left; vertical-alignment: center;
                    }
                }
                Rectangle {
                    height: 24px;
                    TouchArea { clicked => { root.open_location("downloads"); } }
                    Text {
                        x: 0px; width: parent.width; height: parent.height;
                        text: "Downloads"; color: Theme.secondary; font-size: 13px;
                        horizontal-alignment: left; vertical-alignment: center;
                    }
                }
                Rectangle {
                    height: 24px;
                    TouchArea { clicked => { root.open_location("pictures"); } }
                    Text {
                        x: 0px; width: parent.width; height: parent.height;
                        text: "Imagens"; color: Theme.secondary; font-size: 13px;
                        horizontal-alignment: left; vertical-alignment: center;
                    }
                }
                Rectangle {
                    height: 24px;
                    TouchArea { clicked => { root.open_location("music"); } }
                    Text {
                        x: 0px; width: parent.width; height: parent.height;
                        text: "Músicas"; color: Theme.secondary; font-size: 13px;
                        horizontal-alignment: left; vertical-alignment: center;
                    }
                }
                Rectangle {
                    height: 24px;
                    TouchArea { clicked => { root.open_location("videos"); } }
                    Text {
                        x: 0px; width: parent.width; height: parent.height;
                        text: "Vídeos"; color: Theme.secondary; font-size: 13px;
                        horizontal-alignment: left; vertical-alignment: center;
                    }
                }
                Rectangle { height: 1px; background: Theme.border; }
                Text { text: "DISPOSITIVOS"; color: Theme.muted; font-size: 10px; font-weight: 600; }
                Rectangle {
                    height: 24px;
                    TouchArea { clicked => { root.open_location("filesystem"); } }
                    Text {
                        x: 0px; width: parent.width; height: parent.height;
                        text: "Sistema de arquivos"; color: Theme.secondary; font-size: 12px;
                        horizontal-alignment: left; vertical-alignment: center;
                    }
                }
                Rectangle { vertical-stretch: 1; }
                Text { text: "SAHARA  •  0.1.0"; color: Theme.muted; font-size: 10px; }
            }
        }
        Rectangle { width: 1px; background: Theme.border; }
        VerticalLayout {
            spacing: 0px;
            Rectangle {
                height: 58px;
                background: Theme.topbar;
                HorizontalLayout {
                    padding-left: 20px; padding-right: 20px; spacing: 12px; alignment: center;
                    Rectangle {
                        width: 34px; height: 34px; border-radius: 7px; background: Theme.surface;
                        TouchArea { clicked => { root.go_back(); } }
                        Text { text: "‹"; color: Theme.secondary; font-size: 24px; horizontal-alignment: center; vertical-alignment: center; }
                    }
                    Rectangle {
                        horizontal-stretch: 1; height: 34px; background: Theme.surface;
                        border: 1px solid Theme.border; border-radius: 7px;
                        HorizontalLayout {
                            padding-left: 12px; alignment: center;
                            Text { text: root.current_path; color: Theme.secondary; font-size: 12px; overflow: elide; }
                        }
                    }
                }
            }
            Rectangle { height: 1px; background: Theme.border; }
            VerticalLayout {
                padding: 24px; spacing: 14px;
                Text { text: "Arquivos"; color: Theme.text; font-size: 22px; font-weight: 650; }
                Rectangle {
                    vertical-stretch: 1; background: Theme.surface;
                    border: 1px solid Theme.border; border-radius: 10px;
                    clip: true;
                    if root.entries.length == 0 : Text {
                        text: root.status; color: Theme.muted;
                        horizontal-alignment: center; vertical-alignment: center;
                    }
                    for entry in root.entries : Rectangle {
                        height: 42px;
                        background: transparent;
                        TouchArea {
                            clicked => {
                                if entry.is_directory { root.open_directory(entry.path); }
                            }
                        }
                        HorizontalLayout {
                            padding-left: 14px; padding-right: 14px; spacing: 10px; alignment: center;
                            Text { text: entry.is_directory ? "▰" : "▤"; color: entry.is_directory ? Theme.accent : Theme.muted; font-size: 16px; }
                            Text { text: entry.name; color: Theme.text; font-size: 13px; vertical-alignment: center; }
                        }
                    }
                }
            }
            Rectangle { height: 1px; background: Theme.border; }
            Rectangle {
                height: 34px; background: Theme.topbar;
                HorizontalLayout {
                    padding-left: 20px; padding-right: 20px; alignment: center;
                    Text { text: root.status; color: Theme.muted; font-size: 10px; }
                }
            }
        }
    }
}

export global Theme {
    out property <color> background: #0d0f14;
    out property <color> sidebar: #11141c;
    out property <color> topbar: #11141c;
    out property <color> surface: #171b25;
    out property <color> border: #2a3040;
    out property <color> selection: #30264d;
    out property <color> accent: #8b5cf6;
    out property <color> text: #f3f4f8;
    out property <color> secondary: #c0c5d1;
    out property <color> muted: #a1a8b8;
}
